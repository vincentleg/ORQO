# ISOLATED TEST DATABASE ONLY — copy to .env.test.local (git-ignored). Never put real-database values here.
# Used exclusively by `bun run test:isolated <suite>` (scripts/isolated-test.ts), which never reads .env.local.
# Setup guide: docs/orqo-v2/ISOLATED-TEST-ENVIRONMENT.md

# A DISPOSABLE PostgreSQL database: a separate Neon project ("orqo-test", pooled connection string) or a local one.
DATABASE_URL=
# Must equal the identity of DATABASE_URL: the Neon endpoint id (the "ep-…" part of the host, without "-pooler"),
# or local-<port>-<database> for a local PostgreSQL. The runner also refuses the real and production databases.
ORQO_DESTRUCTIVE_TESTS_PROJECT=
# Optional synthetic preview organization (reserved 7e570000- namespace only).
# TEST_PREVIEW_ORG=7e570000-0000-4000-8000-000000000001
