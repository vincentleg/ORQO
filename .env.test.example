# ISOLATED TEST PROJECT ONLY — copy to .env.test.local (git-ignored). Never put real-project values here.
# Used exclusively by `bun run test:isolated <suite>` (scripts/isolated-test.ts), which never reads .env.local.
# Setup guide: docs/orqo-v2/ISOLATED-TEST-ENVIRONMENT.md

# Test project → Project Settings → API / Data API
NEXT_PUBLIC_SUPABASE_URL=https://<test-project-ref>.supabase.co
# Test project → Project Settings → API Keys → Publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER/TEST ONLY. Test project → Project Settings → API Keys → Secret key (sb_secret_…)
SUPABASE_SECRET_KEY=
# SERVER/TEST ONLY. Test project → Connect → Session pooler connection string (URL-encode the password)
SUPABASE_DB_URL=
# Must equal the TEST project's ref (the <test-project-ref> above). The runner also refuses if it is the real project.
ORQO_DESTRUCTIVE_TESTS_PROJECT=
# Optional synthetic preview organization (reserved 7e570000- namespace only).
# TEST_PREVIEW_ORG=7e570000-0000-4000-8000-000000000001
