# Copy to .env.local (git-ignored). Never commit real values.
# The demo (/demo) runs with no variables at all: deterministic engine, in-memory graph.

# --- Supabase (production app: accounts, workspaces, persistence) -----------
# Public by design; safe in the browser because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# SERVER/OPERATOR ONLY. Not read by the application at runtime; used by the
# integration tests (Auth admin API) and never shipped to the browser.
SUPABASE_SECRET_KEY=sb_secret_<...>
# SERVER/OPERATOR ONLY. Session-pooler connection string (URL-encode the
# password). Used by `bun run db:migrate` and integration-test setup/cleanup.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres

# --- Model gateway (OpenRouter; server-only) ---------------------------------
# Used by Deep research (Phase 3) for entitled workspaces, and by the legacy demo
# routes only when ORQO_DEMO_LIVE_PROVIDERS=on.
OPENROUTER_API_KEY=
# Model for Opportunity Discovery; any OpenRouter model with structured outputs.
ORQO_DISCOVERY_MODEL=google/gemini-3.8-flash
# Set to "off" to disable live AI even when a key is present.
ORQO_LIVE_AI=
# Central task-based model policy (src/lib/server/agents/model-policy.ts).
# Optional; every task defaults to ORQO_DISCOVERY_MODEL. Extraction and synthesis
# should be low-cost; reasoning (and later critique) may be stronger.
ORQO_MODEL_EXTRACTION=
ORQO_MODEL_SYNTHESIS=
ORQO_MODEL_REASONING=
ORQO_MODEL_CRITIQUE=
# Legacy demo routes (/api/discover, /api/research) spend provider credits with
# no plan, quota or usage ledger. Off unless set to "on" (supervised demos only).
ORQO_DEMO_LIVE_PROVIDERS=

# Emergency stop (Phase 12): "on" makes every PAID provider (OpenRouter, Brave) read as
# unconfigured, so research/agents/legacy routes fail closed. Deterministic features keep working.
ORQO_PROVIDERS_KILL_SWITCH=

# --- Web research (Phase 3) ----------------------------------------------------
# Deep research needs a Pro entitlement. No billing exists yet, so it is refused
# for every workspace except the organization ids listed here (operator preview,
# same quota and hard limits). Comma-separated UUIDs.
ORQO_RESEARCH_PREVIEW_ORGS=

# --- Agents (Phase 4) ----------------------------------------------------------
# Agent execution needs the agent's plan (Research Agent: Pro; Partnership: Business).
# No billing exists yet, so agents are locked for every workspace except the
# organization ids listed here (operator preview: not a plan; quotas, limits,
# approvals and deep-research entitlement still apply). Comma-separated UUIDs.
ORQO_AGENT_PREVIEW_ORGS=

# --- Destructive tests (test:db, test:http, e2e*) -------------------------------
# Never set in a shell that targets a project with real workspaces. Must equal the
# project ref of BOTH the API URL and SUPABASE_DB_URL, or the suites refuse to run.
# ORQO_DESTRUCTIVE_TESTS_PROJECT=
# Synthetic preview fixture (reserved 7e570000- namespace; never a real preview org).
# TEST_PREVIEW_ORG=7e570000-0000-4000-8000-000000000001

# --- Neo4j: Opportunity Graph (optional, server-side only) ------------------
# PostgreSQL stays canonical; Neo4j holds a DERIVED per-workspace projection
# that admins rebuild from Network → Opportunity graph. Unset → the graph is a
# preview computed from PostgreSQL. The /demo graph never writes to Neo4j.
# Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Brave Search (Deep research web search; legacy /api/research when enabled)
BRAVE_API_KEY=
