# Copy to .env.local. Every variable is optional: without them ORQO runs fully
# on its deterministic engine and in-memory graph.

# Live reasoning (Connect Agents → "Live AI")
OPENROUTER_API_KEY=
# Model for Opportunity Discovery; any OpenRouter model with structured outputs.
ORQO_DISCOVERY_MODEL=google/gemini-3.8-flash
# Set to "off" to disable live AI even when a key is present.
ORQO_LIVE_AI=

# Neo4j graph persistence (Network → "Sync graph"). Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Public company research (GET /api/research?company=...)
BRAVE_API_KEY=
