{
  "name": "orqo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test src tests/unit",
    "security:check": "bun test src/lib/server/trust-boundary.test.ts src/lib/governance src/lib/server/governance src/lib/server/optimization.test.ts src/lib/missions src/lib/server/missions src/lib/server/hardening.test.ts src/lib/server/research/research.test.ts src/lib/server/auth tests/unit/production-guard.test.ts tests/unit/isolated-env.test.ts && bun audit --audit-level=high",
    "test:db": "bun test --timeout 60000 tests/db",
    "test:http": "bun test --timeout 60000 tests/http",
    "db:status": "bun scripts/db-migrate.ts status",
    "db:migrate": "bun scripts/db-migrate.ts up",
    "e2e": "mkdir -p .screenshots && bun scripts/e2e-demo.ts",
    "e2e:autodemo": "mkdir -p .screenshots && bun scripts/e2e-autodemo.ts",
    "e2e:app": "mkdir -p .screenshots && bun scripts/e2e-app.ts",
    "e2e:agents": "mkdir -p .screenshots && bun scripts/e2e-agents.ts",
    "e2e:discover": "mkdir -p .screenshots && bun scripts/e2e-discover.ts",
    "e2e:network": "mkdir -p .screenshots && bun scripts/e2e-network.ts",
    "e2e:understanding": "mkdir -p .screenshots && bun scripts/e2e-understanding.ts",
    "e2e:opportunities": "mkdir -p .screenshots && bun scripts/e2e-opportunities.ts",
    "e2e:work": "mkdir -p .screenshots && bun scripts/e2e-work.ts",
    "e2e:governance": "mkdir -p .screenshots && bun scripts/e2e-governance.ts",
    "e2e:missions": "mkdir -p .screenshots && bun scripts/e2e-missions.ts",
    "e2e:journey": "mkdir -p .screenshots && bun scripts/e2e-journey.ts",
    "e2e:tour": "mkdir -p .screenshots && bun scripts/e2e-tour.ts",
    "test:isolated:check": "bun --no-env-file scripts/isolated-test.ts check",
    "test:isolated": "bun --no-env-file scripts/isolated-test.ts",
    "prod:db": "bun --no-env-file scripts/production-db.ts",
    "intel:build": "bun training/company-intelligence/dataset/build.ts",
    "intel:split": "bun training/company-intelligence/dataset/split.ts",
    "intel:check": "bun training/company-intelligence/dataset/build.ts --check && bun training/company-intelligence/dataset/split.ts --check",
    "intel:export": "bun training/company-intelligence/dataset/export.ts",
    "intel:eval": "bun training/company-intelligence/eval/run.ts",
    "intel:gate": "bun training/company-intelligence/eval/gate.ts",
    "intel:reward-server": "bun training/company-intelligence/rewards/server.ts",
    "test:training": "bun test training"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@vercel/functions": "^3.10.6",
    "motion": "^13.4.6",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
