{
  "name": "orqo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test src tests/unit",
    "test:db": "bun test --timeout 60000 tests/db",
    "test:http": "bun test --timeout 60000 tests/http",
    "db:status": "bun scripts/db-migrate.ts status",
    "db:migrate": "bun scripts/db-migrate.ts up",
    "e2e": "mkdir -p .screenshots && bun scripts/e2e-demo.ts",
    "e2e:autodemo": "mkdir -p .screenshots && bun scripts/e2e-autodemo.ts",
    "e2e:app": "mkdir -p .screenshots && bun scripts/e2e-app.ts",
    "e2e:agents": "mkdir -p .screenshots && bun scripts/e2e-agents.ts",
    "e2e:discover": "mkdir -p .screenshots && bun scripts/e2e-discover.ts",
    "e2e:network": "mkdir -p .screenshots && bun scripts/e2e-network.ts",
    "e2e:understanding": "mkdir -p .screenshots && bun scripts/e2e-understanding.ts",
    "e2e:opportunities": "mkdir -p .screenshots && bun scripts/e2e-opportunities.ts",
    "e2e:work": "mkdir -p .screenshots && bun scripts/e2e-work.ts",
    "test:isolated:check": "bun --no-env-file scripts/isolated-test.ts check",
    "test:isolated": "bun --no-env-file scripts/isolated-test.ts",
    "prod:db": "bun --no-env-file scripts/production-db.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
